{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/copilot/**",
              "components/core/**",
              "components/voice/**",
              "ui_kits/consumer/**",
              "ui_kits/merchant/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|icon|tone|onClick|key|ref|className|style|children)$/]",
        "message": "<AIAction> doesn't accept that prop. Declared props: title, sub, icon, tone, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIAction'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|danger|neutral)$/]",
        "message": "<AIAction> tone must be one of 'primary' | 'danger' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|soft|square|className|style|key|ref|className|style|children)$/]",
        "message": "<AIAvatar> doesn't accept that prop. Declared props: size, soft, square, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExplainFactor'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|weight|key|ref|className|style|children)$/]",
        "message": "<ExplainFactor> doesn't accept that prop. Declared props: name, weight."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightDelta'] > JSXAttribute > JSXIdentifier[name!=/^(?:dir|text|key|ref|className|style|children)$/]",
        "message": "<InsightDelta> doesn't accept that prop. Declared props: dir, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightDelta'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<InsightDelta> dir must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIRecommendationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconBg|iconColor|title|body|impact|confidence|acceptLabel|onAccept|onDismiss|className|style|key|ref|className|style|children)$/]",
        "message": "<AIRecommendationCard> doesn't accept that prop. Declared props: icon, iconBg, iconColor, title, body, impact, confidence, acceptLabel, onAccept, onDismiss, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIRecommendationCard'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:high|medium|low)$/]",
        "message": "<AIRecommendationCard> confidence must be one of 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIRiskAlert'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|body|confidence|primaryLabel|secondaryLabel|primaryVariant|onPrimary|onSecondary|className|style|key|ref|className|style|children)$/]",
        "message": "<AIRiskAlert> doesn't accept that prop. Declared props: severity, title, body, confidence, primaryLabel, secondaryLabel, primaryVariant, onPrimary, onSecondary, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIRiskAlert'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:critical|high|medium|low)$/]",
        "message": "<AIRiskAlert> severity must be one of 'critical' | 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIRiskAlert'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:high|medium|low)$/]",
        "message": "<AIRiskAlert> confidence must be one of 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIRiskAlert'] > JSXAttribute[name.name='primaryVariant'] > Literal[value!=/^(?:primary|danger|navy|success)$/]",
        "message": "<AIRiskAlert> primaryVariant must be one of 'primary' | 'danger' | 'navy' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|initials|size|bg|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, initials, size, bg, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|success|warning|danger|brand|ai)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'info' | 'success' | 'warning' | 'danger' | 'brand' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|navy|danger|success|neutral)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'navy' | 'danger' | 'success' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: variant, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|ai)$/]",
        "message": "<Chip> variant must be one of 'default' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|value|variant|showLabel|label|className|style|key|ref|className|style|children)$/]",
        "message": "<ConfidenceMeter> doesn't accept that prop. Declared props: level, value, variant, showLabel, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceMeter'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:high|medium|low)$/]",
        "message": "<ConfidenceMeter> level must be one of 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceMeter'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:track|bars)$/]",
        "message": "<ConfidenceMeter> variant must be one of 'track' | 'bars'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|text|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: from, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:assistant|user)$/]",
        "message": "<ChatMessage> from must be one of 'assistant' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|bg|color|iconSize|className|style|children|key|ref|className|style|children)$/]",
        "message": "<IconCircle> doesn't accept that prop. Declared props: icon, size, bg, color, iconSize, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|onAction|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, action, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceAssistant'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|onStateChange|transcript|response|audience|className|style|key|ref|className|style|children)$/]",
        "message": "<VoiceAssistant> doesn't accept that prop. Declared props: state, onStateChange, transcript, response, audience, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceAssistant'] > JSXAttribute[name.name='audience'] > Literal[value!=/^(?:consumer|merchant)$/]",
        "message": "<VoiceAssistant> audience must be one of 'consumer' | 'merchant'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
